{
  "name": "prettier-plugin-ember-hbs-tag",
  "version": "2.0.3",
  "description": "Prettier plugin to format hbs tags",
  "keywords": [
    "ember",
    "emberjs",
    "prettier",
    "prettier-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/prettier-plugin-ember-hbs-tag.git"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "sh build.sh --production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "pnpm build",
    "release:prepare": "changeset version",
    "release:publish": "pnpm build && changeset publish",
    "test": "sh build.sh --test && mt dist-for-testing --quiet",
    "update-test-fixtures": "pnpm build && node \"update-test-fixtures.mjs\""
  },
  "devDependencies": {
    "@babel/types": "^8.0.6",
    "@changesets/cli": "^3.0.3",
    "@codemod-utils/files": "^4.1.1",
    "@codemod-utils/tests": "^3.3.0",
    "@ijlee2-frontend-configs/changesets": "^3.0.3",
    "@ijlee2-frontend-configs/oxlint-node": "^0.3.0",
    "@ijlee2-frontend-configs/prettier": "^3.4.2",
    "@ijlee2-frontend-configs/typescript": "^4.4.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": false
    }
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "22.* || >= 24"
  }
}
